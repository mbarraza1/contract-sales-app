PORT=3000
HOST=127.0.0.1
SEED_ZIP=10013
SEARCH_DISTANCE_MILES=25
ORGANIZATION_NAME=Default Sales Team

# GAF scraper
GAF_DATA_SOURCE=coveo
GAF_COVEO_TOKEN=
GAF_COVEO_PAGE_SIZE=100
GAF_SEARCH_LATITUDE=40.7157
GAF_SEARCH_LONGITUDE=-74
GAF_SCRAPE_HEADLESS=true
GAF_PLAYWRIGHT_CHANNEL=chromium
GAF_SCRAPE_MAX_PAGES=25
GAF_SCRAPE_PROFILE_DETAILS=true
GAF_PROFILE_CONCURRENCY=2
GAF_SCRAPE_DAILY_AT=02:00
GAF_SCRAPE_RUN_ON_START=false
GAF_CACHE_PATH=storage/gaf-contractors-10013.json

# Optional. When omitted, the app runs from local demo fixtures.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/contract_sales

# Optional. Used by the enrichment service scaffold.
PERPLEXITY_API_KEY=
PERPLEXITY_API_URL=https://api.perplexity.ai/chat/completions
PERPLEXITY_MODEL=sonar-pro
